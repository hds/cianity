workflow ci {
    stage build {
        template base ( variables = ( RUST_BACKTRACE = 1, CARGO_TERM_COLOR = always ) ) [
            step build { cargo build }
        ]

        job compile ( inherit = base ) [
            steps,
        ]

        job lint (
            inherit = base,
            variables = ( RUST_BACKTRACE = full ),
        ) [
            steps,
        ]
    }
}
