workflow ci {
    stage build {
        template base [
            step setup { rustup update }
            step build { cargo build }
            step test { cargo test }
        ]

        template quick ( inherit = base ) [
            step setup,
            step lint { cargo clippy }
        ]

        template lint_only ( inherit = quick ) [
            step lint,
        ]

        job narrowed ( inherit = lint_only ) [
            steps,
        ]

        job kept ( inherit = quick ) [
            step setup,
        ]
    }
}
