{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Ciane",
  "scopeName": "source.ciane",
  "fileTypes": ["ciane", "ci"],
  "patterns": [
    { "include": "#comment" },
    { "include": "#workflow-def" },
    { "include": "#use-decl" },
    { "include": "#stage" },
    { "include": "#template-def" },
    { "include": "#defaults" }
  ],
  "repository": {

    "comment": {
      "match": "#.*$",
      "name": "comment.line.number-sign.ciane"
    },

    "workflow-def": {
      "comment": "workflow name (attrs)? — highlights keyword, name, and optional attr list; ends before { or at EOL so body is handled by top-level patterns",
      "begin": "\\b(workflow)\\b\\s+([a-zA-Z_][a-zA-Z0-9_-]*)",
      "end": "(?=\\{)|$",
      "beginCaptures": {
        "1": { "name": "keyword.other.ciane" },
        "2": { "name": "entity.name.function.ciane" }
      },
      "patterns": [
        { "include": "#attr-list" }
      ]
    },

    "use-decl": {
      "comment": "use name (attrs)? — highlights keyword, name, and optional attr list; ends at EOL",
      "begin": "\\b(use)\\b\\s+([a-zA-Z_][a-zA-Z0-9_-]*)",
      "end": "$",
      "beginCaptures": {
        "1": { "name": "keyword.other.ciane" },
        "2": { "name": "entity.name.function.ciane" }
      },
      "patterns": [
        { "include": "#attr-list" }
      ]
    },

    "defaults": {
      "comment": "begin consumes ( so end: ) is non-zero-width",
      "begin": "\\b(defaults)\\b\\s*(\\()",
      "end": "\\)",
      "beginCaptures": {
        "1": { "name": "keyword.other.ciane" },
        "2": { "name": "punctuation.section.parens.begin.ciane" }
      },
      "endCaptures": { "0": { "name": "punctuation.section.parens.end.ciane" } },
      "patterns": [
        { "include": "#comment" },
        { "include": "#attr" }
      ]
    },

    "stage": {
      "comment": "end: } — stage body's closing brace. Jobs/templates consume their own inner braces first.",
      "begin": "\\b(stage)\\b\\s+([a-zA-Z_][a-zA-Z0-9_-]*)",
      "end": "\\}",
      "beginCaptures": {
        "1": { "name": "keyword.other.ciane" },
        "2": { "name": "entity.name.function.ciane" }
      },
      "endCaptures": { "0": { "name": "punctuation.section.block.end.ciane" } },
      "patterns": [
        { "include": "#comment" },
        { "include": "#attr-list" },
        { "match": "\\{", "name": "punctuation.section.block.begin.ciane" },
        { "include": "#job" },
        { "include": "#template-def" }
      ]
    },

    "job": {
      "comment": "end: } or ] — shell-body leaves } via lookahead so job can consume it; step-list does the same for ]",
      "begin": "\\b(job)\\b\\s+([a-zA-Z_][a-zA-Z0-9_-]*)",
      "end": "}|\\]",
      "beginCaptures": {
        "1": { "name": "keyword.other.ciane" },
        "2": { "name": "entity.name.function.ciane" }
      },
      "endCaptures": { "0": { "name": "punctuation.section.block.end.ciane" } },
      "patterns": [
        { "include": "#comment" },
        { "include": "#attr-list" },
        { "include": "#shell-body" },
        { "include": "#step-list" }
      ]
    },

    "template-def": {
      "comment": "end: ] — step-list leaves ] via lookahead so template can consume it",
      "begin": "\\b(template)\\b\\s+([a-zA-Z_][a-zA-Z0-9_-]*)",
      "end": "\\]",
      "beginCaptures": {
        "1": { "name": "keyword.other.ciane" },
        "2": { "name": "entity.name.function.ciane" }
      },
      "endCaptures": { "0": { "name": "punctuation.section.brackets.end.ciane" } },
      "patterns": [
        { "include": "#comment" },
        { "include": "#attr-list" },
        { "include": "#step-list" }
      ]
    },

    "step-list": {
      "comment": "end: lookahead (?=]) — leaves ] for job/template to consume",
      "begin": "\\[",
      "end": "(?=\\])",
      "beginCaptures": { "0": { "name": "punctuation.section.brackets.begin.ciane" } },
      "patterns": [
        { "include": "#comment" },
        { "include": "#steps-keyword" },
        { "include": "#step" }
      ]
    },

    "steps-keyword": {
      "match": "\\b(steps)\\b",
      "captures": {
        "1": { "name": "keyword.other.ciane" }
      }
    },

    "step": {
      "comment": "end: } consumes the } that shell-body left via its lookahead; lookaheads for step-ref cases",
      "begin": "\\b(step)\\b\\s+([a-zA-Z_][a-zA-Z0-9_-]*)",
      "end": "}|(?=,)|(?=\\])|(?=\\b(?:step|steps|template)\\b)",
      "beginCaptures": {
        "1": { "name": "keyword.other.ciane" },
        "2": { "name": "entity.name.function.ciane" }
      },
      "endCaptures": { "0": { "name": "punctuation.section.block.end.ciane" } },
      "patterns": [
        { "include": "#shell-body" }
      ]
    },

    "shell-body": {
      "comment": "end: lookahead (?=}) — leaves } for the parent step/job to consume",
      "begin": "{",
      "end": "(?=})",
      "beginCaptures": { "0": { "name": "punctuation.section.block.begin.ciane" } }
    },

    "attr-list": {
      "begin": "\\(",
      "end": "\\)",
      "beginCaptures": { "0": { "name": "punctuation.section.parens.begin.ciane" } },
      "endCaptures":   { "0": { "name": "punctuation.section.parens.end.ciane" } },
      "patterns": [
        { "include": "#comment" },
        { "include": "#attr" }
      ]
    },

    "attr": {
      "begin": "([a-zA-Z_][a-zA-Z0-9_]*)\\s*(=)",
      "end": "(?=[,)\\n])",
      "beginCaptures": {
        "1": { "name": "variable.other.member.ciane" },
        "2": { "name": "keyword.operator.assignment.ciane" }
      },
      "patterns": [
        { "include": "#ref-list" },
        { "include": "#number" },
        { "include": "#bare-value" }
      ]
    },

    "ref-list": {
      "begin": "\\[",
      "end": "\\]",
      "beginCaptures": { "0": { "name": "punctuation.section.brackets.begin.ciane" } },
      "endCaptures":   { "0": { "name": "punctuation.section.brackets.end.ciane" } },
      "patterns": [
        { "include": "#comment" },
        { "include": "#ref" }
      ]
    },

    "ref": {
      "match": "[a-zA-Z_][a-zA-Z0-9_-]*(?:[./][a-zA-Z_][a-zA-Z0-9_-]*)*",
      "name": "variable.other.ciane"
    },

    "number": {
      "match": "\\b[0-9]+(?:\\.[0-9]+)?\\b",
      "name": "constant.numeric.ciane"
    },

    "bare-value": {
      "comment": "exclude terminators so the match stops before , ) or newline",
      "match": "[^\\s,)\\n\\r]+",
      "name": "string.unquoted.ciane"
    }

  }
}
