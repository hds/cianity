workflow ci {
    use {
        workflow (
            location = ../shared/templates.ci,
            name = shared,
        )
    }
    
    stage test {
        job unit ( inherit = shared/base ) [
            steps,
        ]
    
        job integration ( inherit = shared/base ) [
            step setup,
            step run { cargo test --test '*' }
        ]
    }
}
